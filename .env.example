# =============================================================================
# Trading Agent System — Example Environment (commit-safe)
# =============================================================================
# Copy to .env.local and fill in your actual keys.
# =============================================================================

# --- LLM Providers ---
OPENROUTER_API_KEY=sk-or-v1-xxxxxxxxxxxx
# DEEPSEEK_API_KEY=sk-xxxxxxxxxxxx
# OPENAI_API_KEY=sk-xxxxxxxxxxxx

# --- LLMPool (multi-provider failover) ---
# Pool tự động dùng các key sau; provider thiếu key sẽ bị skip.
# Chỉ cần 1 key hoạt động là pool chạy được; opencode keyless hoạt động ngay.
GROQ_API_KEY=xxxxxxxxxxxxxxxx
CEREBRAS_API_KEY=xxxxxxxxxxxxxxxx
NVIDIA_API_KEY=xxxxxxxxxxxxxxxx
# GITHUB_TOKEN=github_pat_xxxx        # cho GitHub Models
# MISTRAL_API_KEY=xxxxxxxxxxxxxxxx
# GOOGLE_API_KEY=xxxxxxxxxxxxxxxx     # cho Gemini
# OPENCODE_API_KEY=                   # optional — opencode zen keyless
# LLM_POOL_OLLAMA=1                   # bật ollama local (http://localhost:11434)
# LLM_POOL_QUOTA_FILE=                # đường dẫn file quota (mặc định data/llm_quota.json)

# --- Telegram Alerts ---
TELEGRAM_BOT_TOKEN=1234567890:ABCdefGHIjklMNOpqrsTUVwxyz
TELEGRAM_CHAT_ID=123456789

# --- Binance ---
# Live spot trading via CCXT. Create API keys with: Enable Spot & Futures Trading = ON,
# Enable Reading = ON, Enable Withdrawals = OFF (không cho rút tiền — an toàn nhất).
BINANCE_API_KEY=xxxxxxxxxxxx
BINANCE_API_SECRET=xxxxxxxxxxxx

# --- TimescaleDB ---
TSDB_PASSWORD=trading_secret

# --- Grafana ---
GRAFANA_PASSWORD=admin

# --- Trading ---
TRADING_ENV=development
USE_LLM=true