# =============================================================================
# Trading Agent System — Example Environment (commit-safe)
# =============================================================================
# Copy to .env.local and fill in your actual keys.
# =============================================================================

# --- LLM Providers ---
OPENROUTER_API_KEY=sk-or-v1-xxxxxxxxxxxx
# DEEPSEEK_API_KEY=sk-xxxxxxxxxxxx
# OPENAI_API_KEY=sk-xxxxxxxxxxxx

# --- LLMPool (multi-provider failover) ---
# Pool tự động dùng các key sau; provider thiếu key sẽ bị skip.
# Chỉ cần 1 key hoạt động là pool chạy được; opencode keyless hoạt động ngay.
GROQ_API_KEY=xxxxxxxxxxxxxxxx
CEREBRAS_API_KEY=xxxxxxxxxxxxxxxx
NVIDIA_API_KEY=xxxxxxxxxxxxxxxx
# GITHUB_TOKEN=github_pat_xxxx        # cho GitHub Models
# MISTRAL_API_KEY=xxxxxxxxxxxxxxxx
# GOOGLE_API_KEY=xxxxxxxxxxxxxxxx     # cho Gemini
# OPENCODE_API_KEY=                   # optional — opencode zen keyless
# LLM_POOL_OLLAMA=1                   # bật ollama local (http://localhost:11434)
# LLM_POOL_QUOTA_FILE=                # đường dẫn file quota (mặc định data/llm_quota.json)

# --- Telegram Alerts ---
TELEGRAM_BOT_TOKEN=1234567890:ABCdefGHIjklMNOpqrsTUVwxyz
TELEGRAM_CHAT_ID=123456789

# --- Binance ---
# Live spot trading via CCXT. Create API keys with: Enable Spot Trading = ON,
# Enable Reading = ON, Enable Withdrawals = OFF (không cho rút tiền — an toàn nhất).
BINANCE_API_KEY=xxxxxxxxxxxx
BINANCE_API_SECRET=xxxxxxxxxxxx
# Use a separate key for Spot Testnet; never reuse the mainnet key.
BINANCE_TESTNET_API_KEY=xxxxxxxxxxxx
BINANCE_TESTNET_API_SECRET=xxxxxxxxxxxx

# --- TimescaleDB ---
TSDB_PASSWORD=trading_secret

# --- Grafana ---
GRAFANA_PASSWORD=admin

# --- Trading ---
TRADING_ENV=development
USE_LLM=true
# Fail-closed defaults. Testnet execution requires enabled=true + mode=testnet.
# Mainnet requires mode=live plus both confirmation phrases documented in the runbook.
TRADING_EXECUTION_ENABLED=false
TRADING_MODE=disabled
# Optional explicit profile. Use testnet with --testnet; mainnet defaults to the
# hard-capped mainnet-canary profile unless mainnet-normal is explicitly chosen.
# LIVE_TRADING_PROFILE=testnet
# Hard stop: blocks every order submission.
TRADING_KILL_SWITCH=true
# Entry-only stop: blocks BUY while allowing validated risk-reducing SELL orders.
TRADING_ENTRY_KILL_SWITCH=true
# TRADING_LIVE_CONFIRMATION=LIVE_TRADING_WITH_REAL_MONEY
# Immutable deployed commit and a random 32+ character key used to authenticate
# risk-state and evidence artifacts. Keep the HMAC key outside Git.
TRADING_BUILD_SHA=0123456789abcdef0123456789abcdef01234567
LIVE_SAFETY_HMAC_KEY=replace-with-at-least-32-random-characters

# Conservative mainnet limits (fractions are 0..1, not percentages 0..100).
LIVE_MAX_ORDER_USD=100
LIVE_MAX_ORDER_EQUITY_PCT=1.0
LIVE_MAX_SYMBOL_PCT=0.25
LIVE_MAX_GROSS_EXPOSURE_PCT=0.50
LIVE_MIN_CASH_RESERVE_PCT=0.25
LIVE_MAX_DAILY_LOSS_PCT=0.02
LIVE_MAX_DRAWDOWN_PCT=0.05
LIVE_MAX_QUOTE_AGE_SECONDS=15
LIVE_MAX_PRICE_DEVIATION_PCT=0.01
LIVE_MAX_SPREAD_PCT=0.002
LIVE_MAX_BOOK_SLIPPAGE_PCT=0.003
LIVE_MIN_BOOK_DEPTH_MULTIPLE=1.25
# Only deterministic minimum-filter remainders at or below this value may be
# recorded as controlled dust. The code hard-caps this setting at USD 10.
LIVE_MAX_DUST_USD=5
