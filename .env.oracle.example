# Copy to .env.oracle, keep mode 600, and never commit the real file.

# Caddy address: use a real DNS name for automatic HTTPS, e.g. trade.example.com.
# Keep :80 only for an initial IP-only smoke test.
SITE_ADDRESS=:80
CADDY_USER=admin
# Generate interactively: docker run --rm -it caddy:2.10.2-alpine caddy hash-password
# Keep the resulting bcrypt hash single-quoted so $ characters stay literal.
CADDY_PASSWORD_HASH='$2a$14$REPLACE_WITH_A_REAL_CADDY_HASH'

# Separate secret required by destructive/admin API calls in the Web UI.
# Generate: openssl rand -hex 32
WEBUI_API_KEY=REPLACE_WITH_A_RANDOM_64_HEX_SECRET

# Same-origin traffic does not need CORS. Add only explicit trusted origins,
# comma-separated, if a separate frontend must call this API.
WEBUI_ALLOWED_ORIGINS=https://trade.example.com

# Fail-closed defaults. Keep false until Paper Trading has been reviewed.
TRADING_MODE=paper
TRADING_EXECUTION_ENABLED=false
USE_LLM=false
LOG_LEVEL=INFO

# Alpaca credentials. AlpacaAdapter is hard-coded to paper=True in the Web API.
ALPACA_API_KEY=
ALPACA_API_SECRET=

# Optional LLM provider credentials (only needed when USE_LLM=true).
OPENAI_API_KEY=
OPENROUTER_API_KEY=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Bind-mounted state location on the Oracle VM.
APP_STATE_DIR=./runtime
