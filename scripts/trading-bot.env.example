# trading-bot.env — Environment variables for local trading bot
# Copy to ~/.config/systemd/user/trading-bot.env and edit values
# Then: systemctl --user daemon-reload && systemctl --user restart trading-bot

# Telegram (required for notifications)
TELEGRAM_BOT_TOKEN=your_bot_token_from_botfather
TELEGRAM_CHAT_ID=your_chat_id_from_userinfobot

# Exchange & Symbols
EXCHANGE=binance
SYMBOLS=BTC/USDT,ETH/USDT,SOL/USDT
TIMEFRAME=1h

# Capital & Risk
INITIAL_CAPITAL=10000
MAX_DRAWDOWN_PCT=0.15
DAILY_LOSS_LIMIT_PCT=0.08
MAX_POSITION_PCT=0.50
STOP_LOSS_PCT=0.05
COOLDOWN_HOURS=24
MAX_POS_SIZE_PCT=0.25

# Timing
LOOP_INTERVAL=300
DATA_UPDATE_INTERVAL=3600